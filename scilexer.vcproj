	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(SolutionDir)$(ConfigurationName)"
			IntermediateDirectory="$(ConfigurationName)"
			ConfigurationType="2"
			CharacterSet="2"
			>
			<Tool Name="VCPreBuildEventTool" />
			<Tool Name="VCCustomBuildTool" />
			<Tool Name="VCXMLDataGeneratorTool" />
			<Tool Name="VCWebServiceProxyGeneratorTool" />
			<Tool Name="VCMIDLTool" />
			<Tool
				Name="VCCLCompilerTool"
				SuppressStartupBanner="true"
				DebugInformationFormat="3"
				RuntimeLibrary="0"
				Optimization="1"
				InlineFunctionExpansion="1"
				WarningLevel="4"
				ExceptionHandling="1"
				PreprocessorDefinitions="NDEBUG;SCI_LEXER;WIN32;_USRDLL;_WINDOWS;scilexer_EXPORTS"
				AdditionalIncludeDirectories=".\3rdparty\scintilla\include;.\3rdparty\scintilla\src"
			/>
			<Tool Name="VCManagedResourceCompilerTool" />
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="WIN32;NDEBUG;SCI_LEXER;_MBCS;_USRDLL;_WINDOWS;scilexer_EXPORTS"
				AdditionalIncludeDirectories=".\3rdparty\scintilla\include;.\3rdparty\scintilla\src"
			/>
			<Tool Name="VCPreLinkEventTool" />
			<Tool
				Name="VCLinkerTool"
				TargetMachine="1"
				GenerateDebugInformation="true"
				LinkIncremental="1"
				AdditionalDependencies="imm32.lib comctl32.lib kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib"
				AdditionalOptions="/OPT:NOWIN98"
				OutputFile="$(OutDir)\SciLexer.dll"
			/>
			<Tool Name="VCALinkTool" />
			<Tool Name="VCXDCMakeTool" />
			<Tool Name="VCBscMakeTool" />
			<Tool Name="VCFxCopTool" />
			<Tool Name="VCPostBuildEventTool" />
		</Configuration>
	</Configurations>
